% ==============================================================================
% REGRAS E ALGORITMOS (Com suporte a cônjuges e tios(as) por afinidade)
% ==============================================================================

irmao_base(X, Y) :- 
    setof(A, progenitor(A, X), PaisX),
    setof(B, progenitor(B, Y), PaisY),
    X \== Y,
    intersection(PaisX, PaisY, Interseccao),
    Interseccao \== [].

irma(X, Y) :-
    irmao_base(X, Y),
    sexo(X, feminino).

irmao(X, Y) :-
    irmao_base(X, Y),
    sexo(X, masculino).

mae(X, Y) :-
    progenitor(X, Y),
    sexo(X, feminino).

pai(X, Y) :-
    progenitor(X, Y),
    sexo(X, masculino).

% Relação de cônjuges (compartilham um filho)
conjuge(X, Y) :-
    progenitor(X, F),
    progenitor(Y, F),
    X \== Y.

vô(X, Y) :-
    sexo(X, masculino),
    setof(A, (progenitor(X, A), progenitor(A, Y)), _).

vó(X, Y) :-
    sexo(X, feminino),
    setof(A, (progenitor(X, A), progenitor(A, Y)), _).

% Tios por sangue (auxiliares)
tio_sangue(X, Y) :-
    sexo(X, masculino),
    irmao_base(X, A),
    progenitor(A, Y).

tia_sangue(X, Y) :-
    sexo(X, feminino),
    irmao_base(X, A),
    progenitor(A, Y).

% Tio (consanguíneo ou esposo da tia)
tio(X, Y) :-
    sexo(X, masculino),
    (   tio_sangue(X, Y)
    ;   (tia_sangue(Tia, Y), conjuge(X, Tia))
    ).

% Tia (consanguínea ou esposa do tio)
tia(X, Y) :-
    sexo(X, feminino),
    (   tia_sangue(X, Y)
    ;   (tio_sangue(Tio, Y), conjuge(X, Tio))
    ).

primo_rel(X, Y) :-
    progenitor(P1, X),
    progenitor(P2, Y),
    irmao_base(P1, P2),
    X \== Y.

primo(X, Y) :-
    setof(Pr, primo_rel(Pr, Y), Lista),
    member(X, Lista).

filho(X, Y) :-
    progenitor(Y, X).

% ==============================================================================
% EXIBIÇÃO VERTICAL DE TODAS AS RELAÇÕES DE UM INDIVÍDUO
% ==============================================================================

mostrar_relacoes(Pessoa) :-
    format('~n----------------------------------------~n', []),
    format('Pessoa: ~w~n', [Pessoa]),
    format('Parentes:~n', []),
    
    % Pai
    (   pai(P, Pessoa) -> format('  Pai: ~w~n', [P]) 
    ;   format('  Pai: Nenhum~n') 
    ),
    
    % Mãe
    (   mae(M, Pessoa) -> format('  Mãe: ~w~n', [M]) 
    ;   format('  Mãe: Nenhum~n') 
    ),
    
    % Esposo(a) / Cônjuge
    (   setof(C, conjuge(C, Pessoa), Conjuges) -> format('  Esposo(a): ~w~n', [Conjuges]) 
    ;   format('  Esposo(a): Nenhum~n') 
    ),
    
    % Filhos
    (   setof(F, filho(F, Pessoa), Filhos) -> format('  Filhos: ~w~n', [Filhos]) 
    ;   format('  Filhos: Nenhum~n') 
    ),
    
    % Irmãos
    (   setof(I, irmao(I, Pessoa), Irmaos) -> format('  Irmãos: ~w~n', [Irmaos]) 
    ;   format('  Irmãos: Nenhum~n') 
    ),
    
    % Irmãs
    (   setof(Ir, irma(Ir, Pessoa), Irmas) -> format('  Irmãs: ~w~n', [Ir]) 
    ;   format('  Irmãs: Nenhum~n') 
    ),
    
    % Avô
    (   setof(V, vô(V, Pessoa), AvosM) -> format('  Avô: ~w~n', [AvosM]) 
    ;   format('  Avô: Nenhum~n') 
    ),
    
    % Avó
    (   setof(Vo, vó(Vo, Pessoa), AvosF) -> format('  Avó: ~w~n', [AvosF]) 
    ;   format('  Avó: Nenhum~n') 
    ),
    
    % Tios (inclui sangue e esposos de tias)
    (   setof(T, tio(T, Pessoa), Tios) -> format('  Tios: ~w~n', [Tios]) 
    ;   format('  Tios: Nenhum~n') 
    ),
    
    % Tias (inclui sangue e esposas de tios)
    (   setof(Ti, tia(Ti, Pessoa), Tias) -> format('  Tias: ~w~n', [Tias]) 
    ;   format('  Tias: Nenhum~n') 
    ),
    
    % Primos
    (   setof(Pr, primo_rel(Pr, Pessoa), Primos) -> format('  Primos: ~w~n', [Primos]) 
    ;   format('  Primos: Nenhum~n') 
    ),
    format('----------------------------------------~n', []).
